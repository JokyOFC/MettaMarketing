# Metta platform — copy to .env and adjust. `npm run dev:api` and `npm start`
# read .env automatically (node --env-file-if-exists). Never commit .env.

# development | production | test
# In production the session cookie is Secure: serve the app over HTTPS.
NODE_ENV=development

# API server (the Vite dev server proxies /api and /dl to it)
HOST=127.0.0.1
PORT=8787

# Public address of the app, used in e-mail links and Mercado Pago return URLs.
# Development default: http://127.0.0.1:5173
APP_URL=http://127.0.0.1:5173

# Secret used to sign temporary download links. Required in production, at least 32 characters, e.g.:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# In development it is generated once and stored in DATA_DIR/.secret.
APP_SECRET=

# MySQL 8.0.23+ (required). The database is created on first start when the
# user may (CREATE); tables come from server/db/migrations. Add ?ssl=true for TLS.
DATABASE_URL=mysql://metta:troque-esta-senha@127.0.0.1:3306/metta
# Connections kept by the API.
DB_POOL_SIZE=10
# Tests (npm test) create and drop one database per test server (metta_test_*)
# on this server — or on DATABASE_URL's server when empty. Only these two keys
# are read from .env by the tests.
TEST_DATABASE_URL=

# Private file storage (uploads, previews, ZIPs). Default: server/data (inside
# site/). Keep it outside public/ and dist/, and back it up with the database.
DATA_DIR=

# Vite build served in production. Default: dist (inside site/).
DIST_DIR=

# Upload limit per file, in MB.
MAX_UPLOAD_MB=1024

# Behind a reverse proxy (nginx, Caddy, load balancer): true, a hop count
# (1) or a list of trusted addresses. Leave empty when Node faces the internet.
TRUST_PROXY=

# E-mail (SMTP). Use SMTP_URL or the individual fields. Without them e-mails
# stay in the outbox as "not_configured" and the admin panel says so.
SMTP_URL=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# true for port 465 (implicit TLS)
SMTP_SECURE=false
MAIL_FROM="Metta Marketing <nao-responda@mettamkt.com.br>"

# Mercado Pago. Without the access token the finance module shows
# "Mercado Pago não configurado" and creates no charges.
MP_ACCESS_TOKEN=
# Secret of the webhook signature (x-signature), from the Mercado Pago panel.
MP_WEBHOOK_SECRET=
MP_API_BASE=https://api.mercadopago.com

# ffmpeg/ffprobe for video posters and metadata. Detected on PATH when empty.
FFMPEG_PATH=
FFPROBE_PATH=

# How long generated ZIP packages stay available, in hours.
ZIP_RETENTION_HOURS=24

# AssinaVelox (contracts signed when a client acquires a plan or a one-off
# service such as brand identity). Without the URL and the key, orders and
# plans work without contracts and Configurações › Contratos says so.
# API base, ending in /api/v1. Production: https://app.assinavelox.com.br/api/v1
# (the app host; assinavelox.com.br is only the institutional site).
ASSINAVELOX_API_URL=
# Key created in AssinaVelox › API e integrações › Chaves with the abilities:
# envelopes:read envelopes:write envelopes:send documents:read recipients:read
# webhooks:manage embedded_signing:manage
ASSINAVELOX_TOKEN=
# Optional: secret of a webhook endpoint registered by hand in AssinaVelox.
# Not needed when the notifications are connected from Configurações › Contratos.
ASSINAVELOX_WEBHOOK_SECRET=
# Minutes between the periodic checks of open contracts (0 turns it off).
ASSINAVELOX_SYNC_MINUTES=5
# Time limit of each call to the AssinaVelox API, in milliseconds.
ASSINAVELOX_TIMEOUT_MS=30000
