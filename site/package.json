{
  "name": "metta-marketing",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "dev:api": "node --watch --no-warnings=ExperimentalWarning --env-file-if-exists=.env server/index.js",
    "build": "vite build",
    "preview": "vite preview --host 127.0.0.1",
    "start": "node --no-warnings=ExperimentalWarning --env-file-if-exists=.env server/index.js",
    "test": "node --no-warnings=ExperimentalWarning --test \"server/test/**/*.test.js\"",
    "seed:dev": "node --no-warnings=ExperimentalWarning --env-file-if-exists=.env server/scripts/seed-dev.js",
    "create-admin": "node --no-warnings=ExperimentalWarning --env-file-if-exists=.env server/scripts/create-admin.js"
  },
  "dependencies": {
    "@fontsource/cormorant-garamond": "^5.2.0",
    "@fontsource/manrope": "^5.2.0",
    "@fontsource/raleway": "^5.2.0",
    "@pdf-lib/fontkit": "^1.1.1",
    "archiver": "^8.0.0",
    "busboy": "^1.6.0",
    "express": "^5.2.1",
    "lucide-react": "^1.48.0",
    "mysql2": "^3.24.4",
    "nodemailer": "^10.0.12",
    "pdf-lib": "^1.17.1",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-router-dom": "^7.18.4",
    "sharp": "^0.35.5",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.5.0",
    "vite": "^7.0.0"
  },
  "engines": {
    "node": ">=22.13"
  }
}
